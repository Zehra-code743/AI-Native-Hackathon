{
  "name": "book",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "concurrently --names \"FRONTEND,AUTH,BACKEND\" --prefix-colors \"blue,magenta,green\" \"npm run start:frontend\" \"npm run start:auth\" \"npm run start:backend\"",
    "start:frontend": "node --max-old-space-size=6144 node_modules/@docusaurus/core/bin/docusaurus.mjs start",
    "start:auth": "cd auth-server && node server.js",
    "start:backend": "cd backend && python start_server.py",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "^3.0.0",
    "better-auth": "^1.4.7",
    "better-sqlite3": "^12.5.0",
    "clsx": "^2.0.0",
    "drizzle-orm": "^0.41.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "concurrently": "^8.2.2",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
